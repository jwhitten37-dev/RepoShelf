{
  "name": "reposhelf",
  "displayName": "RepoShelf",
  "description": "Remote-first repository workspaces for VS Code.",
  "icon": "resources/reposhelf-icon.png",
  "version": "0.1.0",
  "private": true,
  "publisher": "chiefwizard",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jwhitten37-dev/RepoShelf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhitten37-dev/RepoShelf.git"
  },
  "bugs": {
    "url": "https://github.com/jwhitten37-dev/RepoShelf/issues"
  },
  "galleryBanner": {
    "color": "#334155",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.137.0",
    "node": ">=24 <25"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "gitlab",
    "remote repositories",
    "sparse checkout",
    "partial clone",
    "workspace management"
  ],
  "activationEvents": [
    "onFileSystem:reposhelffs",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reposhelf.addInstance",
        "title": "Add GitLab Instance",
        "category": "RepoShelf",
        "icon": "$(add)"
      },
      {
        "command": "reposhelf.removeInstance",
        "title": "Remove GitLab Instance",
        "category": "RepoShelf",
        "icon": "$(remove)"
      },
      {
        "command": "reposhelf.testConnection",
        "title": "Test GitLab Connection",
        "category": "RepoShelf",
        "icon": "$(plug)"
      },
      {
        "command": "reposhelf.refreshCatalog",
        "title": "Refresh Catalog",
        "category": "RepoShelf",
        "icon": "$(refresh)"
      },
      {
        "command": "reposhelf.searchProjects",
        "title": "Search Projects",
        "category": "RepoShelf",
        "icon": "$(search)"
      },
      {
        "command": "reposhelf.clearProjectSearch",
        "title": "Clear Project Search",
        "category": "RepoShelf",
        "icon": "$(clear-all)"
      },
      {
        "command": "reposhelf.selectBranch",
        "title": "Select Branch",
        "category": "RepoShelf",
        "icon": "$(git-branch)"
      },
      {
        "command": "reposhelf.openRemoteFile",
        "title": "Open Remote File",
        "category": "RepoShelf"
      },
      {
        "command": "reposhelf.editLocally",
        "title": "Edit Locally",
        "category": "RepoShelf",
        "icon": "$(cloud-download)"
      },
      {
        "command": "reposhelf.checkWorkspaceSafety",
        "title": "Check Workspace Safety",
        "category": "RepoShelf",
        "icon": "$(shield)"
      },
      {
        "command": "reposhelf.releaseWorkspace",
        "title": "Release Local Workspace",
        "category": "RepoShelf",
        "icon": "$(trash)"
      },
      {
        "command": "reposhelf.pushAndReleaseWorkspace",
        "title": "Push and Release Local Workspace",
        "category": "RepoShelf",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "reposhelf.showWorkspaceLifecycleActions",
        "title": "Show Workspace Lifecycle Actions",
        "category": "RepoShelf",
        "icon": "$(repo)"
      },
      {
        "command": "reposhelf.refreshLocalWorkspaces",
        "title": "Refresh Local Workspaces",
        "category": "RepoShelf",
        "icon": "$(refresh)"
      },
      {
        "command": "reposhelf.sortLocalWorkspaces",
        "title": "Sort Local Workspaces",
        "category": "RepoShelf",
        "icon": "$(list-ordered)"
      },
      {
        "command": "reposhelf.filterLocalWorkspaces",
        "title": "Filter Local Workspaces",
        "category": "RepoShelf",
        "icon": "$(filter)"
      },
      {
        "command": "reposhelf.reopenManagedWorkspace",
        "title": "Reopen Managed Workspace",
        "category": "RepoShelf",
        "icon": "$(folder-opened)"
      },
      {
        "command": "reposhelf.showWorkspaceDiagnostics",
        "title": "Show Workspace Diagnostics",
        "category": "RepoShelf",
        "icon": "$(output)"
      },
      {
        "command": "reposhelf.checkManagedWorkspaceSafety",
        "title": "Check Workspace Safety",
        "category": "RepoShelf",
        "icon": "$(shield)"
      },
      {
        "command": "reposhelf.pushAndReleaseManagedWorkspace",
        "title": "Push and Release Local Workspace",
        "category": "RepoShelf",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "reposhelf.releaseManagedWorkspace",
        "title": "Release Local Workspace",
        "category": "RepoShelf",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reposhelf",
          "title": "RepoShelf",
          "icon": "resources/reposhelf-activitybar.svg"
        }
      ]
    },
    "views": {
      "reposhelf": [
        {
          "id": "reposhelf.catalog",
          "name": "Remote Catalog",
          "icon": "$(cloud)"
        },
        {
          "id": "reposhelf.localWorkspaces",
          "name": "Local Workspaces",
          "icon": "$(repo)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "reposhelf.catalog",
        "contents": "Connect to your corporate GitLab without creating a local clone.\n[Add GitLab Instance](command:reposhelf.addInstance)",
        "when": "reposhelf.hasInstance == false"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "reposhelf.releaseWorkspace",
          "when": "reposhelf.isManagedWorkspace == true"
        },
        {
          "command": "reposhelf.pushAndReleaseWorkspace",
          "when": "reposhelf.isManagedWorkspace == true"
        },
        {
          "command": "reposhelf.checkWorkspaceSafety",
          "when": "reposhelf.isManagedWorkspace == true"
        },
        {
          "command": "reposhelf.reopenManagedWorkspace",
          "when": "false"
        },
        {
          "command": "reposhelf.showWorkspaceDiagnostics",
          "when": "false"
        },
        {
          "command": "reposhelf.checkManagedWorkspaceSafety",
          "when": "false"
        },
        {
          "command": "reposhelf.pushAndReleaseManagedWorkspace",
          "when": "false"
        },
        {
          "command": "reposhelf.releaseManagedWorkspace",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "reposhelf.checkWorkspaceSafety",
          "when": "reposhelf.isManagedWorkspace == true",
          "group": "navigation@80"
        },
        {
          "command": "reposhelf.pushAndReleaseWorkspace",
          "when": "reposhelf.isManagedWorkspace == true",
          "group": "navigation@81"
        },
        {
          "command": "reposhelf.releaseWorkspace",
          "when": "reposhelf.isManagedWorkspace == true",
          "group": "navigation@82"
        }
      ],
      "view/title": [
        {
          "command": "reposhelf.addInstance",
          "when": "view == reposhelf.catalog",
          "group": "navigation@1"
        },
        {
          "command": "reposhelf.clearProjectSearch",
          "when": "view == reposhelf.catalog && reposhelf.projectSearchActive == true",
          "group": "navigation@1.5"
        },
        {
          "command": "reposhelf.testConnection",
          "when": "view == reposhelf.catalog && reposhelf.hasInstance == true",
          "group": "navigation@2"
        },
        {
          "command": "reposhelf.refreshCatalog",
          "when": "view == reposhelf.catalog && reposhelf.hasInstance == true",
          "group": "navigation@3"
        },
        {
          "command": "reposhelf.refreshLocalWorkspaces",
          "when": "view == reposhelf.localWorkspaces",
          "group": "navigation@3"
        },
        {
          "command": "reposhelf.filterLocalWorkspaces",
          "when": "view == reposhelf.localWorkspaces",
          "group": "navigation@1"
        },
        {
          "command": "reposhelf.sortLocalWorkspaces",
          "when": "view == reposhelf.localWorkspaces",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "reposhelf.searchProjects",
          "when": "view == reposhelf.catalog && viewItem == instance",
          "group": "inline@1"
        },
        {
          "command": "reposhelf.removeInstance",
          "when": "view == reposhelf.catalog && viewItem == instance",
          "group": "inline@2"
        },
        {
          "command": "reposhelf.refreshCatalog",
          "when": "view == reposhelf.catalog && (viewItem == instance || viewItem == group)",
          "group": "inline@3"
        },
        {
          "command": "reposhelf.selectBranch",
          "when": "view == reposhelf.catalog && viewItem == project",
          "group": "inline@2"
        },
        {
          "command": "reposhelf.editLocally",
          "when": "view == reposhelf.catalog && (viewItem == project || viewItem == remoteFolder || viewItem == remoteFile)",
          "group": "inline@3"
        },
        {
          "command": "reposhelf.reopenManagedWorkspace",
          "when": "view == reposhelf.localWorkspaces && viewItem == managedWorkspace",
          "group": "inline@1"
        },
        {
          "command": "reposhelf.showWorkspaceDiagnostics",
          "when": "view == reposhelf.localWorkspaces && viewItem == managedWorkspace",
          "group": "inline@2"
        },
        {
          "command": "reposhelf.checkManagedWorkspaceSafety",
          "when": "view == reposhelf.localWorkspaces && viewItem == managedWorkspace",
          "group": "reposhelf@1"
        },
        {
          "command": "reposhelf.pushAndReleaseManagedWorkspace",
          "when": "view == reposhelf.localWorkspaces && viewItem == managedWorkspace",
          "group": "reposhelf@2"
        },
        {
          "command": "reposhelf.releaseManagedWorkspace",
          "when": "view == reposhelf.localWorkspaces && viewItem == managedWorkspace",
          "group": "reposhelf@3"
        }
      ]
    },
    "configuration": {
      "title": "RepoShelf",
      "properties": {
        "reposhelf.instances": {
          "type": "array",
          "default": [],
          "scope": "machine-overridable",
          "description": "Configured GitLab instances. Each instance uses an independent UUID-based identity and SecretStorage PAT.",
          "items": {
            "type": "object",
            "required": [
              "schemaVersion",
              "instanceId",
              "label",
              "baseUrl",
              "enabled"
            ],
            "properties": {
              "schemaVersion": {
                "type": "number",
                "enum": [
                  1
                ]
              },
              "instanceId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "reposhelf.cloneRoot": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "machine-overridable",
          "description": "Host-local root for extension-managed Git checkouts. Defaults to ~/reposhelf-workspaces."
        },
        "reposhelf.api.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 120000,
          "scope": "machine-overridable",
          "description": "Timeout in milliseconds for each GitLab API request."
        },
        "reposhelf.api.maxGetRetries": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 3,
          "scope": "machine-overridable",
          "description": "Maximum automatic retries for transient GitLab GET failures. Remote writes are never retried automatically."
        },
        "reposhelf.cache.maxFileBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 65536,
          "maximum": 20971520,
          "scope": "machine-overridable",
          "description": "Maximum remote file size retained in the in-memory cache."
        },
        "reposhelf.cache.maxTotalBytes": {
          "type": "number",
          "default": 52428800,
          "minimum": 1048576,
          "maximum": 209715200,
          "scope": "machine-overridable",
          "description": "Maximum total size of the in-memory remote file cache."
        },
        "reposhelf.disk.warningBytes": {
          "type": "number",
          "default": 2147483648,
          "minimum": 0,
          "maximum": 1099511627776,
          "scope": "machine-overridable",
          "description": "Advisory disk-usage threshold in bytes for the Local Workspaces dashboard. Set to 0 to disable size warnings. This setting never causes automatic release or deletion."
        },
        "reposhelf.disk.inactiveDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 3650,
          "scope": "machine-overridable",
          "description": "Days since last open before the Local Workspaces dashboard recommends reviewing a retained workspace. Recommendations never cause automatic release or deletion."
        },
        "reposhelf.reminders.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Show non-destructive reminders for long-retained managed workspaces. Reminders never push, release, or delete automatically."
        },
        "reposhelf.reminders.ageDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 365,
          "scope": "machine-overridable",
          "description": "Days since a managed workspace was last opened before RepoShelf may show a reminder."
        },
        "reposhelf.reminders.snoozeHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "maximum": 720,
          "scope": "machine-overridable",
          "description": "Hours that Remind Me Later suppresses reminders for the selected workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run check && node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "compile": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/vscode": "1.137.0",
    "@vitest/coverage-v8": "5.0.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
